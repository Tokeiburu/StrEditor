<UserControl x:Class="StrEditor.WPF.SimpleSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StrEditor.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
			 PreviewMouseLeftButtonDown="UserControl_PreviewMouseLeftButtonDown"
			 PreviewMouseUp="UserControl_PreviewMouseUp"
			 PreviewMouseMove="UserControl_PreviewMouseMove"
			 Background="Transparent">
	<Slider x:Name="_slider" Grid.Column="2" Grid.Row="1" Style="{StaticResource GrfSliderStyle}" Minimum="-20" Maximum="20" IsSnapToTickEnabled="True" Value="{Binding Value, RelativeSource={RelativeSource AncestorType=local:SimpleSlider}, Mode=TwoWay}" />
</UserControl>
