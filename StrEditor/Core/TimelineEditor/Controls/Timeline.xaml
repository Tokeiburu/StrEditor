<UserControl x:Class="StrEditor.Core.TimelineEditor.Controls.Timeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StrEditor.Core.TimelineEditor.Controls" xmlns:keyframeeditor="clr-namespace:StrEditor.Core.TimelineEditor"
			 mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="25" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<ScrollViewer Name="_svTimeline" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" FocusVisualStyle="{x:Null}" Grid.Row="0">
			<Grid Name="_gridTopPart" Background="Transparent">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Name="_timelineIndicatorColumn" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="25" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid Name="_gridTopRow" Grid.Row="0" Height="5" VerticalAlignment="Bottom">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="5*"/>
						<ColumnDefinition Width="27*"/>
					</Grid.ColumnDefinitions>
					<Grid.Background>
						<VisualBrush x:Name="_brushTest" TileMode="Tile" Viewport="0,0,50,5" ViewportUnits="Absolute">
							<VisualBrush.Visual>
								<Grid>
									<Image Source="pack://application:,,,/Resources/keyframe_t.png" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
								</Grid>
							</VisualBrush.Visual>
						</VisualBrush>
					</Grid.Background>
				</Grid>
				<keyframeeditor:TimelineIndicatorRenderer x:Name="_renderer" />
			</Grid>
		</ScrollViewer>
		
		<Grid IsHitTestVisible="false" Grid.RowSpan="2">
			<ScrollViewer Name="_svTopPartFrameSelector" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" FocusVisualStyle="{x:Null}" IsHitTestVisible="False">
				<Grid Name="_gridFrameIndexSelector" HorizontalAlignment="Left" VerticalAlignment="Top">
					<Grid.RowDefinitions>
						<RowDefinition Height="25" />
						<RowDefinition />
					</Grid.RowDefinitions>
					<local:TimelineSelector x:Name="_timelineSelector" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-1 0 0 0" />
					<local:TimelineSelectorLine HorizontalAlignment="Left" x:Name="_timelineSelectorLine" VerticalAlignment="Top" Grid.Row="1" />
				</Grid>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
