<UserControl x:Class="StrEditor.Core.KeyframeEditor.KeyFrameEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wpf="clr-namespace:StrEditor.WPF"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
             xmlns:sliders="clr-namespace:ColorPicker.Sliders;assembly=ColorPicker"
             xmlns:local="clr-namespace:StrEditor.Core.KeyframeEditor"
             mc:Ignorable="d" SnapsToDevicePixels="True"
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid Background="Transparent" Name="_gridEvents" PreviewDragEnter="_gridEvents_DragEnter" PreviewDrop="_gridEvents_Drop" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Content="Frame" Grid.Row="0" Margin="3" Padding="0" VerticalAlignment="Center" />
        <TextBlock Name="_tbFrameIndex" Grid.Row="0" Grid.Column="1" Margin="3" Padding="0" VerticalAlignment="Center" />
        <DockPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right">
            <Label Content="Max Frame" Margin="3" Padding="0" VerticalAlignment="Center" />
            <TextBox Name="_tbMaxFrames" Margin="3" Padding="0" Width="40" IsEnabled="false" VerticalAlignment="Center" />
			<Button Grid.Row="0" Grid.Column="2" Name="_buttonEditMaxFrames" Width="22" Height="22" Margin="3" Click="_buttonEditMaxFrames_Click">
                <Image Width="16" Height="16" Source="pack://application:,,,/Resources/document.png" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Button>
        </DockPanel>
        <Label Content="Color" Grid.Row="1" Margin="3" Padding="0" VerticalAlignment="Center" />
		<wpf:QuickColorSelector InnerMargin="1" Height="22" Margin="2 2 2 2" x:Name="_qcsKeyFrameColor" Grid.Column="1" Grid.Row="1" Width="77" HorizontalAlignment="Left" ColorChanged="_qcsKeyFrameColor_ColorChanged" />
        <Grid Grid.Row="1" Grid.Column="2">
            <DockPanel HorizontalAlignment="Left">
				<TextBox Name="_tbColorR" Margin="3 3 0 3" Width="43" TextChanged="_tbColor_TextChanged" />
                <TextBox Name="_tbColorG" Margin="-1 3 0 3" Width="43" TextChanged="_tbColor_TextChanged" />
                <TextBox Name="_tbColorB" Margin="-1 3 0 3" Width="43" TextChanged="_tbColor_TextChanged" />
                <TextBox Name="_tbColorA" Margin="-1 3 3 3" Width="43" TextChanged="_tbColor_TextChanged" />
            </DockPanel>
        </Grid>
        <Label Content="Blend" Grid.Row="2" Margin="3" Padding="0" VerticalAlignment="Center" />
        <Label Name="_labelOffset" Content="Offset" Grid.Row="3" Margin="3" Padding="0" VerticalAlignment="Center" />
        <DockPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Grid.ColumnSpan="2">
            <TextBox Name="_tbPosX" Margin="3 3 0 3" Width="50" TextChanged="_tbPosX_TextChanged" />
            <TextBox Name="_tbPosY" Margin="-1 3 0 3" Width="50" TextChanged="_tbPosY_TextChanged" />
            <TextBlock Name="_labelAngle" Text="Angle" Margin="3" Padding="0" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
            <TextBox Name="_tbAngle" Margin="3" Width="50" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" TextChanged="_tbAngle_TextChanged" />
        </DockPanel>
		<DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="3">
			<ComboBox Name="_cbSrc" Width="100" SelectionChanged="_cbSrc_SelectionChanged">
				<ComboBoxItem>Zero</ComboBoxItem>
				<ComboBoxItem>One</ComboBoxItem>
				<ComboBoxItem>SrcColor</ComboBoxItem>
				<ComboBoxItem>iSrcColor</ComboBoxItem>
				<ComboBoxItem>SrcAlpha</ComboBoxItem>
				<ComboBoxItem>iSrcAlpha</ComboBoxItem>
				<ComboBoxItem>DstAlpha</ComboBoxItem>
				<ComboBoxItem>iDstAlpha</ComboBoxItem>
				<ComboBoxItem>DstColor</ComboBoxItem>
				<ComboBoxItem>iDstColor</ComboBoxItem>
				<ComboBoxItem>SrcAlphaSat</ComboBoxItem>
				<ComboBoxItem>BothSrcAlpha</ComboBoxItem>
				<ComboBoxItem>BothInverseSrcAlpha</ComboBoxItem>
			</ComboBox>
			<ComboBox Name="_cbDst" Width="100" Margin="6 0 0 0" HorizontalAlignment="Left" SelectionChanged="_cbDst_SelectionChanged">
				<ComboBoxItem>Zero</ComboBoxItem>
			    <ComboBoxItem>One</ComboBoxItem>
			    <ComboBoxItem>SrcColor</ComboBoxItem>
			    <ComboBoxItem>iSrcColor</ComboBoxItem>
			    <ComboBoxItem>SrcAlpha</ComboBoxItem>
			    <ComboBoxItem>iSrcAlpha</ComboBoxItem>
			    <ComboBoxItem>DstAlpha</ComboBoxItem>
			    <ComboBoxItem>iDstAlpha</ComboBoxItem>
			    <ComboBoxItem>DstColor</ComboBoxItem>
			    <ComboBoxItem>iDstColor</ComboBoxItem>
			    <ComboBoxItem>SrcAlphaSat</ComboBoxItem>
			    <ComboBoxItem>BothSrcAlpha</ComboBoxItem>
			    <ComboBoxItem>BothInverseSrcAlpha</ComboBoxItem>
		    </ComboBox>
		</DockPanel>
		<Label Name="_labelP1" Content="P1XY" Grid.Row="6" Margin="3" Padding="0" VerticalAlignment="Center" />
        <DockPanel Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Grid.ColumnSpan="2">
			<TextBox Name="_tbCoordsTLX" Margin="3 3 0 3" Width="50" TextChanged="_boxPos_TextChanged" />
			<TextBox Name="_tbCoordsTLY" Margin="-1 3 0 3" Width="50" TextChanged="_boxPos_TextChanged" />
            <TextBlock Name="_labelP2" Text="P2XY" Margin="3" Padding="0" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
			<TextBox Name="_tbCoordsTRX" Margin="3 3 0 3" Width="50" TextChanged="_boxPos_TextChanged" />
			<TextBox Name="_tbCoordsTRY" Margin="-1 3 3 3" Width="50" TextChanged="_boxPos_TextChanged" />
        </DockPanel>
        <Label Name="_labelP4" Content="P4XY" Grid.Row="7" Margin="3" Padding="0" VerticalAlignment="Center" />
		<DockPanel Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" Grid.ColumnSpan="2">
			<TextBox Name="_tbCoordsBLX" Margin="3 3 0 3" Width="50" TextChanged="_boxPos_TextChanged" />
			<TextBox Name="_tbCoordsBLY" Margin="-1 3 0 3" Width="50" TextChanged="_boxPos_TextChanged" />
			<TextBlock Name="_labelP3" Text="P3XY" Margin="3" Padding="0" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
			<TextBox Name="_tbCoordsBRX" Margin="3 3 0 3" Width="50" TextChanged="_boxPos_TextChanged" />
			<TextBox Name="_tbCoordsBRY" Margin="-1 3 3 3" Width="50" TextChanged="_boxPos_TextChanged" />
		</DockPanel>
		<Label Name="_label" Content="Scale" Grid.Row="8" Margin="3" Padding="0" VerticalAlignment="Center" />
		<DockPanel Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left" Grid.ColumnSpan="3">
			<TextBox Name="_tbScaleX" Margin="3 3 0 3" Width="50" TextChanged="_tbScaleX_TextChanged" />
			<TextBox Name="_tbScaleY" Margin="-1 3 0 3" Width="50" TextChanged="_tbScaleY_TextChanged" />
		</DockPanel>
		<Label Name="_labelUvSpacer" Visibility="Collapsed" Content="" Grid.Row="9" Margin="3" Padding="0" VerticalAlignment="Center" />
		<Label Name="_labelUvP1" Visibility="Collapsed" Content="P1UV" Grid.Row="10" Margin="3" Padding="0" VerticalAlignment="Center" />
		<DockPanel Name="_dockPanelUvT" Visibility="Collapsed" Grid.Row="10" Grid.Column="1" HorizontalAlignment="Left" Grid.ColumnSpan="2">
			<TextBox Name="_tbUVTLX" Margin="3 3 0 3" Width="50" TextChanged="_boxUVs_TextChanged" />
			<TextBox Name="_tbUVTLY" Margin="-1 3 0 3" Width="50" TextChanged="_boxUVs_TextChanged" />
			<TextBlock Name="_labelUvP2" Text="P2UV" Margin="3" Padding="0" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
			<TextBox Name="_tbUVTRX" Margin="3 3 0 3" Width="50" TextChanged="_boxUVs_TextChanged" />
			<TextBox Name="_tbUVTRY" Margin="-1 3 3 3" Width="50" TextChanged="_boxUVs_TextChanged" />
		</DockPanel>
		<Grid Grid.Row="11" Grid.ColumnSpan="5" HorizontalAlignment="Left">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto" />
				<ColumnDefinition Width="auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Label Grid.Row="0" Grid.Column="0" Content="Texture" Margin="3" Padding="0" VerticalAlignment="Center" />
			<ComboBox Grid.Row="0" Grid.Column="1" Name="_selectedTexture" Width="220" MinHeight="50" Margin="3" SelectionChanged="_selectedTexture_SelectionChanged">
				<ComboBox.ItemTemplate>
					<DataTemplate DataType="{x:Type local:TextureView}">
						<StackPanel Orientation="Horizontal" Margin="2">
							<Image Source="{Binding Image}" 
							   Width="40" 
							   Height="40" 
							   Stretch="Uniform"
							   VerticalAlignment="Center"/>
							<TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="8,0,0,0"/>
						</StackPanel>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<Button Grid.Row="0" Grid.Column="2" Name="_buttonEditTextures" Width="22" Height="22" Margin="3" Click="_buttonEditTextures_Click">
				<Image Width="16" Height="16" Source="pack://application:,,,/Resources/settings.png" RenderOptions.BitmapScalingMode="NearestNeighbor" />
			</Button>
			<Label Grid.Row="1" Grid.Column="0" Content="Anim" Margin="3" Padding="0" VerticalAlignment="Center" />
			<DockPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
				<ComboBox Name="_cbAnimations" Width="100" Margin="3" HorizontalAlignment="Left" SelectionChanged="_cbAnimations_SelectionChanged">
					<ComboBoxItem Content="Normal" />
					<ComboBoxItem Content="Unknown" />
					<ComboBoxItem Content="Texture (once)" />
					<ComboBoxItem Content="Texture (loop)" />
				</ComboBox>
				<Label Content="Delay" Margin="3" Padding="0" VerticalAlignment="Center" />
				<TextBox Name="_tbDelay" Margin="3" VerticalContentAlignment="Center" TextChanged="_tbDelay_TextChanged" />
			</DockPanel>
		</Grid>
		<Grid Grid.Row="12" Grid.ColumnSpan="6" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Label Grid.Row="0" Content="Interpolated" Margin="3" Padding="0" VerticalAlignment="Center" />
            <Label Grid.Row="1" Content="Scale Bias" Margin="3" Padding="0" VerticalAlignment="Center" />
            <Label Grid.Row="2" Content="Offset Bias" Margin="3" Padding="0" VerticalAlignment="Center" />
			<Label Grid.Row="3" Content="Angle Bias" Margin="3" Padding="0" VerticalAlignment="Center" />
			<TextBox Grid.Row="1" Grid.Column="1" Name="_tbScaleBias" Margin="3 3 3 3" Width="50" TextChanged="_tbScaleBias_TextChanged" />
			<TextBox Grid.Row="2" Grid.Column="1" Name="_tbOffsetBias" Margin="3 3 3 3" Width="50" TextChanged="_tbOffsetBias_TextChanged" />
			<TextBox Grid.Row="3" Grid.Column="1" Name="_tbAngleBias" Margin="3 3 3 3" Width="50" TextChanged="_tbAngleBias_TextChanged" />
			<DockPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right">
				<Label Grid.Row="4" Content="FPS" Margin="3" Padding="0" VerticalAlignment="Center" />
				<TextBox Name="_tbFps" Grid.Row="4" Grid.Column="1" Margin="3" Width="50" HorizontalAlignment="Left" TextChanged="_tbFps_TextChanged" />
			</DockPanel>
			<CheckBox Name="_isInterpolated" Grid.Row="0" Grid.Column="1" Margin="3" VerticalAlignment="Center" HorizontalAlignment="Left" Click="_isInterpolated_Click" />
			<sliders:SliderColor Grid.Column="2" Grid.Row="1" x:Name="_sliderScale" Height="20" Margin="2" VerticalAlignment="Top" ValueChanged="_sliderScale_ValueChanged" />
            <sliders:SliderColor Grid.Column="2" Grid.Row="2" x:Name="_sliderOffset" Height="20" Margin="2" VerticalAlignment="Top" ValueChanged="_sliderOffset_ValueChanged" />
			<sliders:SliderColor Grid.Column="2" Grid.Row="3" x:Name="_sliderAngle" Height="20" Margin="2" VerticalAlignment="Top" ValueChanged="_sliderAngle_ValueChanged" />
			<Label Name="_labelBezierP1" Content="Bezier P1" Grid.Row="4" Margin="3" Padding="0" VerticalAlignment="Center" />
            <DockPanel Name="_dockPanelBezier" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Grid.ColumnSpan="2">
				<TextBox Name="_tbBezierP1X" Margin="3 3 0 3" Width="50" TextChanged="_boxBezier_TextChanged" />
				<TextBox Name="_tbBezierP1Y" Margin="-1 3 0 3" Width="50" TextChanged="_boxBezier_TextChanged" />
                <TextBlock x:Name="_labelBezierP2" Text="Bezier P2" Margin="3" Padding="0" VerticalAlignment="Center" Width="50" TextAlignment="Right" />
				<TextBox Name="_tbBezierP2X" Margin="3 3 0 3" Width="50" TextChanged="_boxBezier_TextChanged" />
				<TextBox Name="_tbBezierP2Y" Margin="-1 3 3 3" Width="50" TextChanged="_boxBezier_TextChanged" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
