<UserControl x:Class="StrEditor.Core.GifExporter.GifEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
             xmlns:wpf="clr-namespace:StrEditor.Core"
             xmlns:wpf1="clr-namespace:StrEditor.WPF"
             xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Content="Fps" VerticalAlignment="Center" Margin="3" Padding="0" />
			<TextBox Name="_tbFps" Grid.Column="1" HorizontalAlignment="Left" Width="50" Margin="3" Text="{Binding Fps, UpdateSourceTrigger=PropertyChanged}" />
			<Label Content="Destination" Grid.Row="1" VerticalAlignment="Center" Margin="3" Padding="0" Visibility="{Binding GifControlsVisibility}" />

			<Grid Grid.Column="1" Grid.Row="1" Visibility="{Binding GifControlsVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
				<Button Name="_buttonSelectOutput" Width="25" Height="25" Click="_buttonSelectOutput_Click" TokeiLibrary:WpfProperties.ImagePath="arrowdown.png" />
                <TextBox Height="25" VerticalContentAlignment="Center" Grid.Column="1" VerticalAlignment="Center" Margin="3" AllowDrop="true" PreviewDragOver="_tbOutput_PreviewDragOver" DragEnter="_tbOutput_DragEnter" Drop="_tbOutput_Drop" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Name="_tbSaveAs" Content="Browse..." Height="25" Margin="3" MinWidth="100" Click="_tbSaveAs_Click" DragEnter="_tbSaveAs_DragEnter" Drop="_tbSaveAs_Drop" AllowDrop="true" />
            </Grid>

            <Label Content="Select P1" Grid.Row="3" Margin="3" Padding="0" VerticalAlignment="Center" />
            <DockPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Grid.ColumnSpan="2">
				<TextBox Margin="3 3 0 3" Width="50" Text="{Binding BoundsP1X, UpdateSourceTrigger=PropertyChanged}" />
				<TextBox Margin="-1 3 0 3" Width="50" Text="{Binding BoundsP1Y, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Select P2" Margin="3" Padding="0" VerticalAlignment="Center" Width="50" TextAlignment="Right" />
				<TextBox Margin="3 3 0 3" Width="50" Text="{Binding BoundsP2X, UpdateSourceTrigger=PropertyChanged}" />
				<TextBox Margin="-1 3 3 3" Width="50" Text="{Binding BoundsP2Y, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

			<Label Content="Background" Grid.Row="4" VerticalAlignment="Center" Margin="3" Padding="0" Visibility="{Binding GifControlsVisibility}" />
			<wpf1:QuickColorSelector x:Name="_colorBackground" Grid.Row="4" Grid.Column="1" Width="105" HorizontalAlignment="Left" Visibility="{Binding GifControlsVisibility}" />

            <Label Content="Start" Grid.Row="5" VerticalAlignment="Center" Margin="3" Padding="0" />
			<TextBox Name="_tbStart" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Width="50" Margin="3" Text="{Binding FrameIndexStart, UpdateSourceTrigger=PropertyChanged}" />

            <Label Content="End" Grid.Row="6" VerticalAlignment="Center" Margin="3" Padding="0" />
			<TextBox Name="_tbEnd" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Width="50" Margin="3" Text="{Binding FrameIndexEnd, UpdateSourceTrigger=PropertyChanged}" />

			<CheckBox Name="_cbSkipFrames" Grid.Row="7" Margin="3" Content="Allow skipping frames to match FPS" Grid.ColumnSpan="2" IsChecked="{Binding AllowSkipFrames}" Visibility="{Binding GifControlsVisibility}" />

			<Label Content="Progress" Grid.Row="8" VerticalAlignment="Center" Margin="3" Padding="0" />
            <styles:TkProgressBar x:Name="_progressBar" Grid.Row="8" Grid.Column="1" Margin="2" />

            <Label Grid.Row="8" Content="" VerticalAlignment="Center" Margin="3" Padding="0" />
            <DockPanel Grid.Row="9" Grid.ColumnSpan="3" HorizontalAlignment="Right">
				<Button Name="_buttonReset" Width="80" Height="25" Content="Reset" Margin="3" Command="{Binding ResetCommand}" />
				<Button Name="_buttonCancel" Width="80" Height="25" Content="Cancel" Margin="3" Command="{Binding CancelCommand}" IsEnabled="{Binding IsCancelEnabled}" />
				<Button Name="_buttonSave" Width="80" Height="25" Content="Save" Margin="3" Command="{Binding SaveCommand}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
